{
  "name": "tompathy",
  "version": "0.3.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "testbed": "npm run build && node scripts/testbed.mjs && node scripts/start-testbed.mjs",
    "chrome": "node scripts/open-chrome.mjs",
    "review": "npm run build && node scripts/open-chrome.mjs",
    "test:review": "node scripts/review-validation.mjs",
    "test:website": "node scripts/website-validation.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test:native": "node scripts/native-validation.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node scripts/test-core.mjs",
    "test:browser": "playwright test",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.1.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "fflate": "^0.8.2",
    "prettier": "^3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "license": "MIT",
  "description": "A Chrome side-panel reader for exploring externally supplied creator attention, process and values."
}
